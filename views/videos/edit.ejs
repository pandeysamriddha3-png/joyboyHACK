<%- include('../partials/header') %>

<div class="container container-sm">
  <div class="page-header">
    <h1 class="page-title">Edit Video</h1>
  </div>

  <% if (errors.length > 0) { %>
    <div class="form-errors">
      <% errors.forEach(err => { %>
        <p class="form-error"><%= err.msg %></p>
      <% }) %>
    </div>
  <% } %>

  <form action="/videos/<%= video.id %>/edit" method="POST" class="edit-form" id="edit-video-form">
    <!-- Video Preview -->
    <div class="edit-preview">
      <% if (video.thumbnail) { %>
        <img src="/uploads/<%= video.thumbnail %>" alt="<%= video.title %>" class="edit-thumb">
      <% } else { %>
        <div class="thumb-placeholder edit-thumb-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </div>
      <% } %>
      <div class="edit-file-info">
        <p><%= helpers.formatFileSize(video.file_size) %> · <%= video.mime_type %></p>
        <% if (video.duration) { %>
          <p>Duration: <%= helpers.formatDuration(video.duration) %></p>
        <% } %>
      </div>
    </div>

    <div class="form-group">
      <label for="title">Title <span class="required">*</span></label>
      <input type="text" id="title" name="title" value="<%= video.title %>" required maxlength="200">
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" maxlength="5000"><%= video.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="visibility">Visibility</label>
      <select id="visibility" name="visibility" class="form-select">
        <option value="public" <%= video.visibility === 'public' ? 'selected' : '' %>>Public — Visible to all members</option>
        <option value="private" <%= video.visibility === 'private' ? 'selected' : '' %>>Private — Only you and admins</option>
      </select>
    </div>

    <div class="form-actions">
      <a href="/videos/<%= video.id %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary" id="btn-save-video">Save Changes</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
