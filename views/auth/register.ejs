<%- include('../partials/header') %>

<div class="auth-container">
  <div class="auth-card">
    <div class="auth-header">
      <span class="auth-logo">▶</span>
      <h1>Create your account</h1>
      <p>Join the <%= siteName %> community</p>
    </div>

    <% if (errors.length > 0) { %>
      <div class="form-errors">
        <% errors.forEach(err => { %>
          <p class="form-error"><%= err.msg %></p>
        <% }) %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST" class="auth-form" id="register-form">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Choose a username"
               value="<%= typeof formData !== 'undefined' ? formData.username || '' : '' %>"
               required autofocus minlength="3" maxlength="30" pattern="[a-zA-Z0-9_-]+">
        <span class="form-hint">3–30 characters. Letters, numbers, hyphens, underscores.</span>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com"
               value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>"
               required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="At least 6 characters" required minlength="6">
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Type your password again" required>
      </div>

      <button type="submit" class="btn btn-primary btn-full" id="btn-register">Create Account</button>
    </form>

    <div class="auth-footer">
      <p>Already have an account? <a href="/auth/login">Log in</a></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
